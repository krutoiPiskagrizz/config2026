# Стартовый скрипт этапа 5: rm, help и обработка ошибок
# --- help
help
help extra
# --- исходное состояние VFS
ls -l
# --- rm: удаление файла (путь относительный и абсолютный)
rm hello.txt
ls
rm /notes.txt
ls
# --- rm: несколько файлов сразу
rm docs/todo.txt bin/data.bin
ls docs bin
# --- rm без -r на каталоге (ошибка), потом rm -r: каталог целиком
rm docs
rm -r docs
ls
# --- rm: ошибки
rm ghost
rm
rm -z bin
rm bin
rm /
# --- нельзя удалить текущий каталог
cd bin
rm -r /bin
rm -r ../bin
cd /
# --- после выхода из каталога его уже можно удалить
rm -r bin
ls
# --- общие ошибки
foo
exit extra
exit
